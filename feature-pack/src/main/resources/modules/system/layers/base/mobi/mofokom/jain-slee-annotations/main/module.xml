    <dependencies>

        <module name="javax.ejb.api" export="true" />
        <module name="org.jboss.as.ejb3" export="true" />
        <module name="org.telestax.slee.container.lib" export="true" />
        <!--
        <module name="org.jboss.ejb-client" export="true"/>
        <module name="javax.ejb.api" export="true"/>
        -->
        <module xmlns="urn:jboss:module:1.3" name="javax.resource.api" />
        <module name="org.yaml.snakeyaml" export="true" />
        <module name="com.fasterxml.jackson.core.jackson-core" export="true" />
        <module name="com.fasterxml.jackson.core.jackson-databind" export="true" />
        <system export="true">
            <paths>
                <path name="javax/xml" />
                <path name="javax/xml/datatype" />
                <path name="javax/xml/namespace" />
                <path name="javax/xml/parsers" />
                <path name="javax/xml/stream" />
